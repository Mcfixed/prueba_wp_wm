# ──────────────────────────────────────────────
# WhatsApp Manager - Environment Configuration
# ──────────────────────────────────────────────

# App
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_manager
POSTGRES_USER=wm_user
POSTGRES_PASSWORD=wm_secure_password
DATABASE_URL=postgresql://postgres:wm_secure_password@localhost:5432/whatsapp_manager

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Encryption (Master key for WhatsApp credentials)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Baileys
BAILEYS_SESSION_DIR=./data/sessions
BAILEYS_MAX_RECONNECT_RETRIES=5
BAILEYS_RECONNECT_INTERVAL=5000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PATH=/ws
