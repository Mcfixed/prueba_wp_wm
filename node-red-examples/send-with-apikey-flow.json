        "func": "var API_KEY = 'wm_3178044ca8a24fe9a8739fe7080d6d20';\nvar SESSION_ID = '7bf9d8a4-cb9f-44df-bb5e-36272e175524';\nvar PHONE = '56982841275';\n\nmsg.method = 'POST';\nmsg.url = 'http://localhost:3000/api/v1/messages/' + SESSION_ID + '/send';\n\nmsg.headers = {\n    'Authorization': 'Bearer ' + API_KEY,\n    'Content-Type': 'application/json'\n};\n\nmsg.payload = {\n    to: PHONE,\n    text: String(msg.payload)\n};\n\nreturn msg;",
