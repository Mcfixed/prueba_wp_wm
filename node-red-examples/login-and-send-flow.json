        "func": "var SESSION_ID = '7bf9d8a4-cb9f-44df-bb5e-36272e175524';\nvar PHONE = '56982841275';\n\nvar token = msg.payload.accessToken;\nvar originalText = flow.get('lastMessageText') || 'Mensaje desde Node-RED';\n\nif (!token) {\n    node.error('No se pudo obtener token', msg);\n    return null;\n}\n\nmsg.method = 'POST';\nmsg.url = 'http://localhost:3000/api/v1/messages/' + SESSION_ID + '/send';\n\nmsg.headers = {\n    'Authorization': 'Bearer ' + token,\n    'Content-Type': 'application/json'\n};\n\nmsg.payload = {\n    to: PHONE,\n    text: originalText\n};\n\nreturn msg;",
